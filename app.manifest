<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<assembly xmlns="urn:schemas-microsoft-com:asm.v1" manifestVersion="1.0"
          xmlns:asmv3="urn:schemas-microsoft-com:asm.v3">
  <assemblyIdentity type="win32" name="app.nottawa" version="1.0.0.0"/>

  <!-- Per-monitor DPI awareness V2 (Win 10 1703+). Fall back to
       PerMonitor (V1) on earlier builds. Never set awareness in code
       (SetProcessDpiAwarenessContext) — HWNDs get created before your
       main() runs and inherit whatever the manifest declared. -->
  <asmv3:application>
    <asmv3:windowsSettings xmlns="http://schemas.microsoft.com/SMI/2016/WindowsSettings"
                            xmlns:ws2="http://schemas.microsoft.com/SMI/2016/WindowsSettings"
                            xmlns:ws3="http://schemas.microsoft.com/SMI/2017/WindowsSettings"
                            xmlns:ws5="http://schemas.microsoft.com/SMI/2020/WindowsSettings">
      <dpiAwareness xmlns="http://schemas.microsoft.com/SMI/2016/WindowsSettings">PerMonitorV2, PerMonitor</dpiAwareness>
      <dpiAware xmlns="http://schemas.microsoft.com/SMI/2005/WindowsSettings">true/pm</dpiAware>

      <!-- Opt in to \\?\-free long paths. User still needs the registry key
           HKLM\SYSTEM\CurrentControlSet\Control\FileSystem\LongPathsEnabled=1
           for it to actually take effect (Win 10 1607+). -->
      <longPathAware xmlns="http://schemas.microsoft.com/SMI/2016/WindowsSettings">true</longPathAware>

      <!-- UTF-8 as the process code page. Makes CreateFileA / _mkdir / anything
           that goes through the A-suffix Win32 layer accept UTF-8 bytes without
           mangling. Win 10 1903+ only; older versions ignore. -->
      <activeCodePage xmlns="http://schemas.microsoft.com/SMI/2019/WindowsSettings">UTF-8</activeCodePage>
    </asmv3:windowsSettings>
  </asmv3:application>

  <!-- Declare compatibility with Win 10 and Win 11. Not declaring these
       makes GetVersionEx lie to us with Win 8 values. -->
  <compatibility xmlns="urn:schemas-microsoft-com:compatibility.v1">
    <application>
      <!-- Win 10 (and Win 11 reports as Win 10 here) -->
      <supportedOS Id="{8e0f7a12-bfb3-4fe8-b9a5-48fd50a15a9a}"/>
      <!-- Win 8.1 (harmless to include) -->
      <supportedOS Id="{1f676c76-80e1-4239-95bb-83d0f6d0da78}"/>
    </application>
  </compatibility>

  <!-- Common Controls v6 for modern-looking message boxes, file dialogs,
       and any Win32 UI we surface. -->
  <dependency>
    <dependentAssembly>
      <assemblyIdentity type="win32" name="Microsoft.Windows.Common-Controls"
                        version="6.0.0.0" processorArchitecture="*"
                        publicKeyToken="6595b64144ccf1df" language="*"/>
    </dependentAssembly>
  </dependency>
</assembly>
